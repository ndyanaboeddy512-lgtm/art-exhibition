# 55 smartCREATIVES — Database Configuration
# ==========================================================

# Option 1: Local MySQL (XAMPP / WAMP / MySQL Server default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=art_gallery_db

# Option 2: Cloud MySQL Connection URL (For Vercel Deployment)
# Paste this into your Vercel Project Settings -> Environment Variables:
# DATABASE_URL=mysql://user:password@host:port/database?ssl={"rejectUnauthorized":true}
