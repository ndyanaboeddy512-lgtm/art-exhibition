{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,services/**}"
    },
    "api/[...path].js": {
      "includeFiles": "{data/**,services/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "cleanUrls": true
}
