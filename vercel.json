{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,services/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ],
  "cleanUrls": true
}
